# Buildora AI Platform Environment Configuration Example

# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_MODEL_TEXT=openai/gpt-oss-20b
LLM_MODEL_VISION=llama-3.2-11b-vision-preview
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET=100000

# Weather Provider Configuration
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Database Configuration (Leave empty to use local SQLite: data/construction.db)
DATABASE_URL=

# ==============================================================================
# Authentication & JWT Security Settings
# ==============================================================================
# Generate a strong 32+ character random string in production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_cryptographically_secure_secret_key
JWT_EXPIRY_HOURS=8
RESET_TOKEN_EXPIRY_MINUTES=20
RATE_LIMIT_PER_MINUTE=5

# ==============================================================================
# SMTP Mail Settings for Password Reset Emails
# (If left empty, reset links will be printed safely to server console for testing)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=no-reply@buildora.ai
SMTP_TLS=true
APP_BASE_URL=http://localhost:8000
